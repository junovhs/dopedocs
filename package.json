{
    "name": "dopedocs",
    "version": "0.6.0",
    "private": false,
    "type": "module",
    "description": "A typed documentation engine: one source renders to an in-app panel and to crawlable static pages, with AEO/GEO annotation enforced by the compiler.",
    "license": "MIT",
    "files": [
        "dist",
        "styles",
        "THIRD_PARTY_NOTICES.md",
        "examples/*.ts",
        "examples/manual-assets",
        "examples/README.md",
        "docs",
        "CHANGELOG.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./panel": {
            "types": "./dist/panel.d.ts",
            "import": "./dist/panel.js"
        },
        "./static": {
            "types": "./dist/static.d.ts",
            "import": "./dist/static.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./astro": {
            "types": "./dist/astro.d.ts",
            "import": "./dist/astro.js"
        },
        "./styles.css": "./styles/dopedocs.css",
        "./shots": {
            "types": "./dist/shots.d.ts",
            "import": "./dist/shots.js"
        },
        "./zoom": {
            "types": "./dist/zoom.d.ts",
            "import": "./dist/zoom.js"
        },
        "./zoom.css": "./styles/zoom.css",
        "./highlight": {
            "types": "./dist/highlight.d.ts",
            "import": "./dist/highlight.js"
        },
        "./theme": {
            "types": "./dist/theme.d.ts",
            "import": "./dist/theme.js"
        }
    },
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build",
        "prepublishOnly": "npm run check && npm test && npm run build",
        "check:examples": "npm run build && node scripts/check-examples.mjs",
        "check:readme": "npm run build && node scripts/check-readme.mjs",
        "check:release": "npm run build && node scripts/check-release.mjs"
    },
    "devDependencies": {
        "@fontsource/fraunces": "^5.3.0",
        "@types/fontkit": "^2.0.9",
        "@types/node": "^22.20.1",
        "photoswipe": "^5.4.4",
        "shiki": "^3.23.0",
        "typescript": "~5.6.2",
        "vitest": "^3.2.7"
    },
    "peerDependencies": {
        "astro": ">=4",
        "photoswipe": "^5.4.4",
        "playwright": ">=1.40",
        "shiki": "^3.0.0",
        "vite": ">=5"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        },
        "playwright": {
            "optional": true
        },
        "astro": {
            "optional": true
        },
        "photoswipe": {
            "optional": true
        },
        "shiki": {
            "optional": true
        }
    },
    "keywords": [
        "documentation",
        "docs",
        "aeo",
        "geo",
        "seo",
        "schema.org",
        "json-ld",
        "vite-plugin",
        "astro-integration",
        "static-site",
        "llms-txt"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/junovhs/dopedocs.git"
    },
    "homepage": "https://github.com/junovhs/dopedocs#readme",
    "bugs": {
        "url": "https://github.com/junovhs/dopedocs/issues"
    },
    "author": "Spencer Nunamaker (Strange Systems)",
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=18"
    },
    "bin": {
        "dopedocs-shots": "dist/shots-cli.js",
        "dopedocs": "dist/cli.js"
    },
    "dependencies": {
        "fontkit": "^2.0.4",
        "postcss": "^8.5.31",
        "wawoff2": "^2.0.1"
    }
}
