{
    "name": "dopedocs",
    "version": "0.4.0",
    "private": false,
    "type": "module",
    "description": "A typed documentation engine: one source renders to an in-app panel and to crawlable static pages, with AEO/GEO annotation enforced by the compiler.",
    "license": "MIT",
    "files": [
        "dist",
        "styles"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./panel": {
            "types": "./dist/panel.d.ts",
            "import": "./dist/panel.js"
        },
        "./static": {
            "types": "./dist/static.d.ts",
            "import": "./dist/static.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./styles.css": "./styles/dopedocs.css"
    },
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build",
        "prepublishOnly": "npm run check && npm test && npm run build"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "typescript": "~5.6.2",
        "vitest": "^3.2.7"
    },
    "peerDependencies": {
        "vite": ">=5"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "keywords": [
        "documentation",
        "docs",
        "aeo",
        "geo",
        "seo",
        "schema.org",
        "json-ld",
        "vite-plugin",
        "static-site",
        "llms-txt"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/junovhs/dopedocs.git"
    },
    "homepage": "https://github.com/junovhs/dopedocs#readme",
    "bugs": {
        "url": "https://github.com/junovhs/dopedocs/issues"
    },
    "author": "Spencer Nunamaker (Strange Systems)",
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=18"
    }
}
